      "page": "/admin/order/[id]",
      "regex": "^/admin/order/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/order/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
